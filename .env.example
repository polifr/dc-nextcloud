# Application configuration
OFFICE_TYPE=onlyoffice

# Nextcloud
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME

# PostgreSQL
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=nc-postgresql

# Redis
REDIS_HOST=nc-redis

# LDAP
LDAP_DOMAIN=nextcloud.local
LDAP_BASE_DN=dc=nextcloud,dc=local
LDAP_ADMIN_PASSWORD=CHANGE_ME
LDAP_READONLY_USER_USERNAME=nc-ldap-bind
LDAP_READONLY_USER_PASSWORD=CHANGE_ME

# Talk HPB
TALK_SIGNALING_URL=wss://talk-signaling.nextcloud.local
TALK_SIGNALING_SECRET=GENERATE_ME
TALK_TURN_SECRET=GENERATE_ME
TALK_INTERNAL_SECRET=GENERATE_ME
